# .env
# Переменные окружения для n8n
# N8N Configuration
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=your-secure-encryption-key-change-this
# Timezone
GENERIC_TIMEZONE=Europe/Moscow
# Database
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_secure_password_change_this
POSTGRES_DB=n8n
# Yandex Cloud API
YANDEX_IAM_TOKEN=your_iam_token_here
YANDEX_FOLDER_ID=your_folder_id_here
# GigaChat API (альтернатива)
GIGACHAT_CLIENT_ID=your_client_id_here
GIGACHAT_CLIENT_SECRET=your_client_secret_here
# Webhook Secret (для безопасности)
WEBHOOK_SECRET=your_webhook_secret_here
